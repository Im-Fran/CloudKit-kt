<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!--
            Receives Apple's sign-in redirect. Apps set the scheme with
            manifestPlaceholders["cloudkitAuthScheme"] = "myapp-cloudkit" and use
            "myapp-cloudkit://auth" as the Sign In Callback of the CloudKit API token.
        -->
        <activity
            android:name=".CloudKitAuthCallbackActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${cloudkitAuthScheme}" />
            </intent-filter>
        </activity>
    </application>

    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
